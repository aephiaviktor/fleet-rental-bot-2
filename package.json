{
  "name": "fleet-rental-bot-2",
  "version": "0.1.42",
  "private": true,
  "author": "Aephia Industries",
  "description": "Next-generation SRSLY fleet reservation watchlist and manager",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && electron .",
    "start:electron": "npm run start",
    "package:dir": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:windows": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@sly-rentals/core": "5.4.0",
    "@solana/kit": "2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.aephia.fleet-rental-bot-2",
    "productName": "Fleet Rental Bot 2",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/fleet-rental-bot-*.ico",
      "ui/**/*",
      "dist/src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/fleet-rental-bot-2.ico",
      "artifactName": "Fleet-Rental-Bot-2-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/fleet-rental-bot-2.png"
    }
  }
}
